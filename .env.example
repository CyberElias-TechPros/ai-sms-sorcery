# ── Frontend (Vite) ────────────────────────────────────────────────
# Base URL of the Sorcery API. Leave empty to use same-origin `/api`
# (dev/preview proxy in vite.config.ts, or the vercel.json rewrite in prod).
VITE_API_URL=

# Dev-only: where the Vite `/api` proxy should forward to.
# Defaults to a local `npm run dev` worker (http://127.0.0.1:8787).
# Point it at a deployed worker to preview against production data:
# VITE_API_PROXY_TARGET=https://ai-sms-sorcery-api.YOUR_SUBDOMAIN.workers.dev
VITE_API_PROXY_TARGET=http://127.0.0.1:8787

# ── Cloudflare Worker (worker/) ────────────────────────────────────
# Set with `npx wrangler secret put NAME` — never commit real values.
# CREDENTIALS_ENCRYPTION_KEY   base64 32-byte AES key (openssl rand -base64 32)
# WEBHOOK_SIGNING_SECRET       optional Twilio auth token for status-callback verification
